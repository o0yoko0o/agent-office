# Copy to .env (`make env-check` does it). .env is not committed.

# Where the office in Docker is reachable: http://BIND_IP:HOST_PORT
# 4848 so an office started on the host (4747) can run alongside.
HOST_PORT=4848
BIND_IP=127.0.0.1

# Non-default transcript folders, mounted read-only at the same path
# (see AGENT_OFFICE_<AGENT>_DIR in `npx theagentoffice --help`).
# AGENT_OFFICE_CLAUDE_DIR=
# AGENT_OFFICE_CODEX_DIR=
# AGENT_OFFICE_OPENCODE_DIR=
